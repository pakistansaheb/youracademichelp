# --- Phase 1: database + auth (needed first) ---

# Neon Postgres connection string (free tier). Get it from your Neon project dashboard.
DATABASE_URL=

# NextAuth secret — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Resend API key (free tier) for sending magic-link emails. If unset, links are logged
# to the server console instead (useful for local dev before you have a key).
RESEND_API_KEY=
EMAIL_FROM="YourAcademicHelp <onboarding@resend.dev>"

# Email address to seed as the first `role: owner` user on their first login.
OWNER_EMAIL=abdulrahmanammad7@gmail.com

# Base URL of the deployed/dev app (used by NextAuth for callback URLs).
AUTH_URL=http://localhost:3000

# --- Phase 3: apprenticeship listings ---

# Find an Apprenticeship Display Advert API key, from
# https://developer.apprenticeships.education.gov.uk/
FIND_APPRENTICESHIP_API_KEY=

# --- Phase 4: email integration ---

# Microsoft Azure AD app registration (Outlook OAuth)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Google Cloud OAuth app (Gmail OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-byte key (base64) used to encrypt stored OAuth tokens at rest.
# Generate with `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
